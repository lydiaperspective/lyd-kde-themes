Window.SetBackgroundTopColor (0.09, 0.06, 0.13);
Window.SetBackgroundBottomColor (0.19, 0.12, 0.25);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - 190);
logo_sprite.SetZ(10);

# Preload all frames before animation begins. This avoids file lookup or
# image-decoding failures from inside Plymouth's periodic refresh callback.
moon_0 = Image("moon-0.png");
moon_1 = Image("moon-1.png");
moon_2 = Image("moon-2.png");
moon_3 = Image("moon-3.png");
moon_4 = Image("moon-4.png");
moon_5 = Image("moon-5.png");
moon_6 = Image("moon-6.png");
moon_7 = Image("moon-7.png");
moon_sprite = Sprite(moon_0);
moon_sprite.SetX(Window.GetWidth() / 2 - moon_0.GetWidth() / 2);
moon_sprite.SetY(Window.GetHeight() / 2 + 15);
moon_sprite.SetZ(20);

status_image = Image.Text("LYD ARK LINUX", 0.91, 0.86, 0.96);
status_sprite = Sprite(status_image);
status_sprite.SetX(Window.GetWidth() / 2 - status_image.GetWidth() / 2);
status_sprite.SetY(Window.GetHeight() / 2 + 125);
status_sprite.SetZ(30);

detail_image = Image.Text("Preparing your desktop...", 0.78, 0.68, 0.86);
detail_sprite = Sprite(detail_image);
detail_sprite.SetX(Window.GetWidth() / 2 - detail_image.GetWidth() / 2);
detail_sprite.SetY(Window.GetHeight() / 2 + 160);
detail_sprite.SetZ(30);

global.frame = 0;
global.tick = 0;
fun refresh_callback() {
  global.tick++;
  if (global.tick >= 10) {
    global.tick = 0;
    global.frame = (global.frame + 1) % 8;
    if (global.frame == 0) { moon_sprite.SetImage(moon_0); }
    else if (global.frame == 1) { moon_sprite.SetImage(moon_1); }
    else if (global.frame == 2) { moon_sprite.SetImage(moon_2); }
    else if (global.frame == 3) { moon_sprite.SetImage(moon_3); }
    else if (global.frame == 4) { moon_sprite.SetImage(moon_4); }
    else if (global.frame == 5) { moon_sprite.SetImage(moon_5); }
    else if (global.frame == 6) { moon_sprite.SetImage(moon_6); }
    else { moon_sprite.SetImage(moon_7); }
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun set_detail(text, red, green, blue) {
  detail_image = Image.Text(text, red, green, blue);
  detail_sprite.SetImage(detail_image);
  detail_sprite.SetX(Window.GetWidth() / 2 - detail_image.GetWidth() / 2);
}

fun message_callback(text) {
  set_detail(text, 0.78, 0.68, 0.86);
}
Plymouth.SetMessageFunction(message_callback);

fun password_callback(prompt, bullets) {
  set_detail(prompt + "  " + bullets, 0.91, 0.86, 0.96);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun question_callback(prompt, entry) {
  set_detail(prompt + "  " + entry, 0.91, 0.86, 0.96);
}
Plymouth.SetDisplayQuestionFunction(question_callback);

fun normal_callback() {
  set_detail("Preparing your desktop...", 0.78, 0.68, 0.86);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

# Keep the animation responsive while boot progress updates arrive.
fun progress_callback(duration, progress) {
  global.progress = progress;
}
Plymouth.SetBootProgressFunction(progress_callback);
