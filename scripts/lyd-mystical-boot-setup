#!/usr/bin/env bash
set -Eeuo pipefail

MARKER=/var/lib/lyd/mystical-boot-setup.done
[[ -e "$MARKER" ]] && exit 0
install -d -m 0755 /var/lib/lyd

# Set the theme for the next generated initramfs. This is intentionally done
# on the installed system, where /boot and the active boot tooling are present.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme --rebuild-initrd lyd-mystical
else
  echo "plymouth-set-default-theme is unavailable; leaving the installed Plymouth configuration in place." >&2
fi

# Fedora's GRUB configuration is generated into /boot/grub2/grub.cfg.
# Keep the theme setting in /etc/default/grub so future regenerations retain it.
if command -v grub2-mkconfig >/dev/null 2>&1; then
  install -d /boot/grub2
  install -d /etc/default
  if grep -q '^GRUB_THEME=' /etc/default/grub 2>/dev/null; then
    sed -i 's|^GRUB_THEME=.*|GRUB_THEME="/usr/share/grub/themes/lyd-mystical/theme.txt"|' /etc/default/grub
  else
    printf '\nGRUB_THEME="/usr/share/grub/themes/lyd-mystical/theme.txt"\n' >> /etc/default/grub
  fi
  grub2-mkconfig -o /boot/grub2/grub.cfg
else
  echo "GRUB configuration path or grub2-mkconfig unavailable; installed theme assets are ready for later activation." >&2
fi

touch "$MARKER"
echo "Mystical boot theme configured. Plymouth initramfs and GRUB configuration were updated where available."
