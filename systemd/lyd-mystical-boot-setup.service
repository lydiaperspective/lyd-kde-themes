[Unit]
Description=Apply the Lyd Mystical GRUB and Plymouth themes when their version changes
Documentation=https://github.com/lydiaperspective/lyd-kde-themes
After=local-fs.target
RequiresMountsFor=/boot
ConditionPathExists=/usr/share/lyd/mystical-theme-version

[Service]
Type=oneshot
ExecStart=/usr/libexec/lyd/lyd-mystical-boot-setup

[Install]
WantedBy=multi-user.target
